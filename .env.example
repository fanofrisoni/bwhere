# Copy to .env.local (git-ignored).

# Option A — real Firebase project (Console → Project settings → Your apps → Web app config)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Option B — local emulators, no Firebase project needed. Leave the keys above empty
# and run: npx firebase-tools emulators:start --project demo-b
# Host = "auto" (same machine as Metro; works on a phone and the iOS simulator), 10.0.2.2 for the Android emulator.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=auto
